{
  "name": "dashbones-spec",
  "version": "0.1.0",
  "description": "Zod v4 schema for Dashbones-compatible JSON dashboards",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:schema": "tsx scripts/generate-schema.ts",
    "gen:go": "tsx scripts/generate-go.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "dashbones",
    "dashboard",
    "zod",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
